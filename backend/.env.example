# --- Evidence mode ---
EVIDENCE_MODE=replay          # "replay" (fixtures, default) or "live" (real public APIs)

# --- NVIDIA NIM: build.nvidia.com (dev) ---
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
# Low-effort tier (Switchyard strong/weak model routing) — used for
# life-safety synthesis when every gate passed and confidence is high, i.e.
# the evidence already agrees and the task is closer to templating than
# reasoning over ambiguity.
NIM_REASONING_MODEL_LIGHT=nvidia/nemotron-3.5-lightning-30b-a3b
# nvidia/neva-22b is listed in the build.nvidia.com catalog but 404s
# ("Function ... Not found for account") on at least one verified account —
# meta/llama-3.2-11b-vision-instruct is confirmed fast/reliable for the
# direct (no-tools) vision call. The DeepAgents path uses a different,
# hardcoded model — see app/agents/vision_specialist.py's _chat_model().
NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# --- NVIDIA NIM: self-hosted on Curiosity v2 (prod) ---
# Two separate self-hosted deployments on two separate ports — a self-hosted
# NIM/vLLM instance serves exactly one model, so the 120b and 30b models are
# NOT interchangeable and must not share a port/URL. Leave either pair unset
# to keep that tier on build.nvidia.com; set both fields in a pair together
# when that model's self-hosted service is up on the cluster. Vision (11b)
# has no self-hosted deployment and always routes to build.nvidia.com.
NIM_PROD_BASE_URL=             # 120b nemotron-3-super (high-effort reasoning)
NIM_PROD_API_KEY=
NIM_PROD_LIGHT_BASE_URL=       # 30b nemotron-3.5-lightning, fine-tuned (low-effort reasoning) — separate port from the 120b instance
NIM_PROD_LIGHT_API_KEY=
# Optional: only set these if vLLM registers a model under a different name
# than NIM_REASONING_MODEL / NIM_REASONING_MODEL_LIGHT above (check with
# `curl <prod base url>/models`) -- e.g. a fine-tuned checkpoint served via
# vLLM commonly registers under its full HF repo path instead of the
# build.nvidia.com catalog shorthand. Leave unset when they match.
NIM_PROD_MODEL=
NIM_PROD_LIGHT_MODEL=
RUNTIME_TARGET=auto           # "auto" (try vLLM first, fall back to API on failure) | "dev" (API only, no vLLM) | "prod" (vLLM only, no fallback)
                               # applies to every model: reasoning (both tiers), vision, and embeddings

# --- NeMo Relay ---
RELAY_ENABLED=true
RELAY_EXPORT_DIR=./var/relay_traces

# --- OpenShell (requires a live OpenShell cluster; off by default) ---
OPENSHELL_ENABLED=false
OPENSHELL_ENDPOINT=
OPENSHELL_BEARER_TOKEN=
OPENSHELL_CLUSTER=

# --- NeMo Retriever (Assistant chat's grounding embeddings) ---
# nemotron-3-embed-1b, self-hosted on its own port (a third, separate
# self-hosted deployment from the two reasoning models above). Optional —
# leave unset to use the hosted build.nvidia.com embedding endpoint (needs
# only NVIDIA_API_KEY above); when set, embed calls try this endpoint first
# and automatically fail over to build.nvidia.com on a connection/timeout/5xx
# error, same failover behavior as the reasoning/vision NIM targets.
NEMO_RETRIEVER_SELF_HOSTED_URL=
NEMO_RETRIEVER_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# --- Demo SMS console (Twilio) ---
# Optional — the SMS console shows "not configured" until all four are set.
# Every send goes to ONE preconfigured recipient, never a number the
# frontend supplies. Get these from https://console.twilio.com/.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=            # your Twilio number, E.164 format e.g. +15551234567
SMS_DEMO_RECIPIENT=            # the one demo phone to notify, E.164 format

# --- Gates ---
CONFIDENCE_GATE_MIN=0.55
EVIDENCE_MIN_AGREEING_SOURCES=2
EVIDENCE_MAX_AGE_MINUTES=90
REQUIRE_HUMAN_APPROVAL=true

# --- Frontend display toggles ---
# Hides the "passed" status badge on the Agentic Runtime gate pipeline cards
# (passing is the expected/silent state — leaves only blocked/degraded gates
# visibly flagged). Default false shows every gate's status, including passed.
HIDE_PASSED_GATES=false

# --- Population baseline, shelters, evacuation routing ---
# All three below are public and keyless — no signup, no key needed. Defaults
# shown here are also the code defaults in config.py; only set these if you
# need to point at a different instance (e.g. a self-hosted Overpass mirror).
# SVI_BASE_URL=https://onemap.cdc.gov/onemapservices/rest/services/SVI/CDC_ATSDR_Social_Vulnerability_Index_2022_USA/MapServer/2
# OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# OSRM_BASE_URL=http://router.project-osrm.org
# Note: OSRM's public demo server is rate-limited and explicitly for
# light/demo use, not production traffic — fine for this hackathon build,
# but self-host OSRM before relying on this for anything beyond a demo.
